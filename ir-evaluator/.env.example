# EDINET API
EDINET_API_KEY=your_edinet_api_key_here

# FRED API（米セントルイス連銀・マクロ経済データ。無料登録で即発行）
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

# e-Stat API（政府統計。CPI・業種別DI/IIP用。無料登録で即発行）
# https://www.e-stat.go.jp/api/ （マイページ → API機能（アプリケーションID発行）
ESTAT_APP_ID=your_estat_app_id_here

# Google Gemini / Vertex AI
GOOGLE_API_KEY=your_gemini_api_key_here
# または Vertex AI を使う場合
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# 審査辞典RAGパイプライン（dictionary/）のモデル指定（省略可、デフォルトは各モジュール参照）
# OCR_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# DICTIONARY_DIR=/path/to/業種別審査辞典_第5版_業種別
# CHROMA_DIR=/path/to/chroma_db

# Chroma DB のデバイス間共有（scripts/chroma_sync.py。詳細は docs/chroma-sync.md）
# 非公開 GCS バケットを正本にして pull/push する
CHROMA_GCS_BUCKET=gs://ir-evaluator-chroma

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_for_reports
